# The public website as a small front end for Kaggle (MODE=kaggle in deploy.sh): no model in this
# container. Each link, upload or transcript becomes a 07_infer run on the owner's Kaggle GPUs with the
# trained adapters (scripts/kaggle_infer.py); the kaggle CLI authenticates from the KAGGLE_API_TOKEN secret.
FROM python:3.12-slim

RUN pip install --no-cache-dir gradio==6.30.0 kaggle==2.2.4 pyyaml requests

ENV PYTHONUNBUFFERED=1 \
    GRADIO_ANALYTICS_ENABLED=False \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=8080

WORKDIR /srv/pod2post
# Everything 07_infer's notebook is built from (scripts/build_notebook.py bundles src/, configs/ and
# requirements-kaggle.txt), plus the site.
COPY requirements-kaggle.txt ./
COPY configs/ configs/
COPY src/ src/
COPY kaggle/07_infer/ kaggle/07_infer/
COPY kaggle/07_deps/ kaggle/07_deps/
COPY scripts/build_notebook.py scripts/kaggle_run.py scripts/kaggle_infer.py scripts/
COPY app/ app/

# 32 MB: Cloud Run's HTTP/1 request limit; longer episodes can be pasted as links.
CMD ["sh", "-c", "exec python3 app/gradio_app.py --backend kaggle --max-file-mb 32 --daily-limit ${DAILY_LIMIT:-10}"]
